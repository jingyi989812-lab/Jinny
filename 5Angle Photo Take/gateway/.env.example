# Copy to ".env" next to server.js and fill in.

# WHERE THE PHOTOS GO.
# Windows Server writing to the Synology over SMB — use the UNC path,
# NOT a mapped drive letter. Mapped drives (Z:) belong to a login session
# and are invisible to a Windows service; the service will fail to write.
DATA_DIR=\\SYNOLOGY-NAS\UR-Klinik-Photos

# Shared key the clinic phones send as the x-photoflow-key header.
# Generate one:  powershell -c "[guid]::NewGuid().ToString('N')"
APP_KEY=replace-me

PORT=8080
MAX_UPLOAD_MB=12
