<?xml version="1.0" encoding="utf-8"?>
<!--
  Optional: put IIS in front of the gateway as the HTTPS front door.
  Requires the URL Rewrite and Application Request Routing (ARR) modules,
  and ARR proxying enabled (IIS Manager > server node > Application Request
  Routing Cache > Server Proxy Settings > Enable proxy).

  Place this in the IIS site root. The site serves nothing itself — it
  forwards everything to the Node gateway on localhost:8080.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="PhotoFlow" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:8080/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Photos are larger than the IIS default of 30 MB total / 2 MB form. -->
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
