<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <!-- PHP classes and PHP settings — not endpoints, never served -->
          <add segment="lib" />
          <add segment=".user.ini" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
